# Backend
NODE_SERVICE_URL=http://localhost:3001
OLLAMA_URL=http://localhost:11434
VERCEL_TOKEN=
DATABASE_URL=sqlite:///./deployguard.db
REDIS_URL=redis://localhost:6379
MONGO_URL=mongodb://localhost:27017

# Frontend
FASTAPI_URL=http://your-ec2-ip:8000
NEXT_PUBLIC_APP_URL=https://your-vercel-app.vercel.app

# GitHub OAuth (for PR merging)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# NOTE: No API keys needed — all LLM inference is local via Ollama

# GitHub API (optional but recommended for Task Assigner feature)
# Without this, GitHub rate-limits you to 60 requests/hour
# Get from: github.com/settings/tokens → Generate new token (classic) → check "repo" scope
GITHUB_TOKEN=your_github_personal_access_token_here
